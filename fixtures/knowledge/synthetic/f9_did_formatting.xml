<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTHETIC F9 FIXTURE. Not JLR evidence and not promotable to evidence.

  Reproduces only the element shape of an SDD DID formatting catalogue so the
  parser can be tested offline. Values exercise parsing branches:

    * an unqualified DID with a single ReadParameter and a known converter;
    * a bit-packed DID whose several ReadParameters carve up one payload;
    * a module-qualified DID;
    * a fully qualified DID whose AND of string tests maps onto applicability,
      including a model-year breakpoint that must not become a year range;
    * a parameter whose converter is absent, which must still be recorded but
      without an invented unit.
-->
<COMPONENT xmlns:xlink="http://www.w3.org/1999/xlink" langcode="en">
<KeyedDataRecordContainer id="Synthetic DIDs">
<Properties>
<key>-1</key>
<dataSize>-1</dataSize>
</Properties>

<KeyedData id="DID 0x0301">
<Properties>
<keySize>769</keySize>
<dataSize>2</dataSize>
</Properties>
<ReadParameter id="1" mask="65535" lsbNumber="0" msbNumber="1">
<Properties>
<name><![CDATA[Synthetic pressure reading]]></name>
</Properties>
<SHORTCUT id="CVT_SYNTH_VOLT" xlink:href="../Converters/CVT_SYNTH_VOLT.xml#CVT_SYNTH_VOLT"/>
</ReadParameter>
</KeyedData>

<KeyedData id="DID 0x0343">
<Properties>
<keySize>835</keySize>
<dataSize>8</dataSize>
</Properties>
<ReadParameter id="1" mask="-1" lsbNumber="0" msbNumber="3">
<Properties>
<name><![CDATA[Synthetic packed value one]]></name>
</Properties>
<SHORTCUT id="CVT_SYNTH_VOLT" xlink:href="../Converters/CVT_SYNTH_VOLT.xml#CVT_SYNTH_VOLT"/>
</ReadParameter>
<ReadParameter id="2" mask="-1" lsbNumber="4" msbNumber="7">
<Properties>
<name><![CDATA[Synthetic packed value two]]></name>
</Properties>
<SHORTCUT id="CVT_SYNTH_MISSING" xlink:href="../Converters/CVT_SYNTH_MISSING.xml#CVT_SYNTH_MISSING"/>
</ReadParameter>
</KeyedData>

<KeyedData id="DID 0x1945 SYNTHMOD">
<Properties>
<enable>
<STRING-TEST-TACTIC id="module">
<Properties>
<string1 xlink:href="../snapshot.xml#ModuleId"/>
<string2>SYNTHMOD</string2>
</Properties>
</STRING-TEST-TACTIC>
</enable>
<keySize>6469</keySize>
<dataSize>2</dataSize>
</Properties>
<ReadParameter id="1" mask="65535" lsbNumber="0" msbNumber="1">
<Properties>
<name><![CDATA[Synthetic module-scoped value]]></name>
</Properties>
<SHORTCUT id="CVT_SYNTH_VOLT" xlink:href="../Converters/CVT_SYNTH_VOLT.xml#CVT_SYNTH_VOLT"/>
</ReadParameter>
</KeyedData>

<KeyedData id="DID 0xDD01 SYNTHMOD">
<Properties>
