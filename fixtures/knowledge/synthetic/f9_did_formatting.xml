<STRING-TEST-TACTIC id="module">
<Properties>
<string1 xlink:href="../snapshot.xml#ModuleId"/>
<string2>SYNTHMOD</string2>
</Properties>
</STRING-TEST-TACTIC>
</enable>
<keySize>56577</keySize>
<dataSize>4</dataSize>
</Properties>
<ReadParameter id="1" mask="4294967295" lsbNumber="0" msbNumber="3">
<Properties>
<name><![CDATA[Total distance]]></name>
</Properties>
<SHORTCUT id="CVT_SYNTH_KM" xlink:href="../Converters/CVT_SYNTH_KM.xml#CVT_SYNTH_KM"/>
