<?xml version="1.0"?>
<!-- Synthetic fixture reproducing the SDD element shape only: a module
     index with one identifier of each access and two routines. No JLR
     content; the numbers and names are invented. -->
<MDX xmlns:xlink="http://www.w3.org/1999/xlink">
	<ADMINISTRATION>
		<ECU_NAME>Synthetic Control Module</ECU_NAME>
		<SHORTNAME>SYNTHMOD</SHORTNAME>
		<SSDS_INFORMATION/>
		<SPECIFICATION_DOCUMENTS/>
	</ADMINISTRATION>
	<PROTOCOL/>
	<ECU_DATA>
		<DATA_IDENTIFIERS>
			<DID ID="did_0100">
				<NAME>Synthetic reading only</NAME>
				<NUMBER>0x0100</NUMBER>
				<BYTE_SIZE>2</BYTE_SIZE>
				<DID_TYPE>single_value</DID_TYPE>
				<ACCESS_PARAMETERS>
					<READABLE SERVICE_REFS="service_22" SESSION_REFS="session_01 session_03"/>
				</ACCESS_PARAMETERS>
			</DID>
			<DID ID="did_0200">
				<NAME>Synthetic written value</NAME>
				<NUMBER>0x0200</NUMBER>
				<BYTE_SIZE>4</BYTE_SIZE>
				<DID_TYPE>bitmapped</DID_TYPE>
				<ACCESS_PARAMETERS>
					<READABLE SERVICE_REFS="service_22" SESSION_REFS="session_01 session_03"/>
					<WRITEABLE SERVICE_REFS="service_2E" SESSION_REFS="session_03"/>
				</ACCESS_PARAMETERS>
			</DID>
			<DID ID="did_0300">
				<NAME>Synthetic controlled output</NAME>
				<NUMBER>0x0300</NUMBER>
				<BYTE_SIZE>1</BYTE_SIZE>
				<DID_TYPE>single_value</DID_TYPE>
				<ACCESS_PARAMETERS>
					<READABLE SERVICE_REFS="service_22" SESSION_REFS="session_01 session_03"/>
					<CONTROLLABLE SERVICE_REFS="service_2F" SESSION_REFS="session_03" SECURITY_REFS="security_level_1" IOCP_REFS="iocp_00 iocp_03"/>
				</ACCESS_PARAMETERS>
			</DID>
			<DID ID="did_no_number">
				<NAME>Synthetic entry with no number</NAME>
				<ACCESS_PARAMETERS>
					<WRITEABLE SERVICE_REFS="service_2E" SESSION_REFS="session_03"/>
				</ACCESS_PARAMETERS>
			</DID>
		</DATA_IDENTIFIERS>
		<DIAGNOSTIC_TROUBLE_CODES/>
		<ROUTINE_IDENTIFIERS>
			<ROUTINE ID="routine_0400" SESSION_REFS="session_03">
				<NAME>Synthetic clear adaptions</NAME>
				<NUMBER>0x0400</NUMBER>
				<MAX_ROUTINE_RUN_TIME>30</MAX_ROUTINE_RUN_TIME>
				<RESTART_WHILE_RUNNING>no</RESTART_WHILE_RUNNING>
			</ROUTINE>
			<ROUTINE ID="routine_0202" SESSION_REFS="session_03">
				<NAME>Synthetic on-demand self test</NAME>
				<NUMBER>0x0202</NUMBER>
				<MAX_ROUTINE_RUN_TIME/>
				<RESTART_WHILE_RUNNING>yes</RESTART_WHILE_RUNNING>
			</ROUTINE>
		</ROUTINE_IDENTIFIERS>
	</ECU_DATA>
</MDX>
