<?xml version="1.0" encoding="UTF-8"?>
<!--
  SYNTHETIC F9 FIXTURE. Not JLR evidence and not promotable to evidence.

  Reproduces the shape of an SDD platform document. Values exercise:
    * two buses at different rates and one behind a gateway;
    * a module with diagnostic and programming addresses, where only the
      diagnostic pair may be ingested;
    * a module whose network is declared and one where it is not;
    * a module with no diagnostic address at all, which yields no claim;
    * a module addressed only by a physical address, recorded verbatim without
      CAN identifiers so that it is seen but never routed;
    * a J1962 connector whose pins are recorded as listed, not assigned to buses.
-->
<platform>
	<platform_name>SYNTHA_10MY</platform_name>
	<network_architecture>
		<connector>
			<name>J1962</name>
			<pin><name>CAN_P_HS</name><number>6</number></pin>
			<pin><name>CAN_N_HS</name><number>14</number></pin>
			<pin><name>SIGNAL_GROUND</name><number>5</number></pin>
			<pin><name>K_LINE_PIN_7</name><number>7</number></pin>
			<pin><name>K_LINE_PIN_8</name><number>8</number></pin>
		</connector>
		<network net_id="CAN_HS" main_net="CAN_HS">
			<protocol type="diagnostic">ISO14229</protocol>
			<can>
				<rate>500</rate>
				<identifier>11</identifier>
			</can>
			<addressing><can_iso15765><normal/></can_iso15765></addressing>
		</network>
		<network net_id="CAN_MS" main_net="CAN_MS">
			<can>
				<rate>125</rate>
				<identifier>29</identifier>
			</can>
			<addressing><can_iso15765><extended/></can_iso15765></addressing>
		</network>
		<network net_id="CAN_FIXED" main_net="CAN_FIXED">
			<protocol type="diagnostic">ISO14229</protocol>
			<can>
				<rate>500</rate>
				<identifier>29</identifier>
			</can>
			<addressing>
				<can_iso15765>
					<normal_fixed>
						<can_id_prefix type="phys">0x18DA</can_id_prefix>
						<can_id_prefix type="func">0x18DB</can_id_prefix>
					</normal_fixed>
				</can_iso15765>
			</addressing>
		</network>
		<!--
		  Two K-line buses (ADR-0029): one states its pin, its framing and its
		  wake-up and speaks a protocol this product implements; the other
		  states no pin and speaks one it only names.
		-->
		<network net_id="DS2_PIN7" main_net="ISO">
			<protocol type="diagnostic">DS2</protocol>
			<protocol type="network">ISO9141</protocol>
			<iso>
				<rate>9600</rate>
				<settings data_bits="8" parity="even" start_bits="1" stop_bits="1"/>
				<wakeup type="bmw_ds2"/>
				<connection>
					<pin type="K_LINE">K_LINE_PIN_7</pin>
				</connection>
			</iso>
			<addressing><iso_9141><normal/></iso_9141></addressing>
		</network>
		<network net_id="KW2000STAR" main_net="ISO">
			<protocol type="diagnostic">KW2000STAR</protocol>
			<protocol type="network">ISO9141</protocol>
			<iso>
				<rate>9600</rate>
				<settings data_bits="8" parity="none" start_bits="1" stop_bits="1"/>
				<wakeup type="bmw_kw2000_star"/>
			</iso>
			<addressing><iso_9141><normal/></iso_9141></addressing>
		</network>
	</network_architecture>
	<car_configuration>
		<master>
			<ccf_source upload="did">SYNTHMOD_SYSTEM_A</ccf_source>
			<qualifier model="SYNTHA" year="MY10"/>
		</master>
	</car_configuration>
	<module_fitment>
		<module>
			<module_code_name acronym="SYNTHMOD" ISOName="SYNTHMOD">SYNTHMOD_SYSTEM_A</module_code_name>
			<address type="can_tx" session="diag">0x7E0</address>
			<address type="can_rx" session="diag">0x7E8</address>
			<address type="can_tx" session="prog">0x111</address>
			<address type="can_rx" session="prog">0x222</address>
			<network>CAN_HS</network>
			<data_identifier_set type="NET">synth_net</data_identifier_set>
			<data_identifier_set type="SWDL">synth_swdl_std<qualifier><qual type="CM_QUAL_SYNTH_HW" value="VAL_STD"/></qualifier></data_identifier_set>
			<data_identifier_set type="SWDL">synth_swdl_plus<qualifier><qual type="CM_QUAL_SYNTH_HW" value="VAL_PLUS"/></qualifier></data_identifier_set>
			<data_identifier_set type="PDI">synth_pdi</data_identifier_set>
			<data_identifier_set type="APP_DATA_COLLECT">synth_net</data_identifier_set>
			<fitment>mandatory</fitment>
		</module>
		<module>
			<module_code_name acronym="OTHERMOD" ISOName="OTHERMOD">OTHERMOD_SYSTEM_A</module_code_name>
			<address type="can_tx" session="diag">0x760</address>
			<address type="can_rx" session="diag">0x768</address>
			<network>CAN_MS</network>
			<data_identifier_set type="NET">synth_net</data_identifier_set>
			<data_identifier_set type="PDI">synth_undefined</data_identifier_set>
			<fitment>optional</fitment>
		</module>
		<module>
			<module_code_name acronym="LEGACYMOD" ISOName="LEGACYMOD">LEGACYMOD_SYSTEM_A</module_code_name>
			<address type="phys" session="diag">0x10</address>
			<address type="phys" session="prog">0x10</address>
			<network>CAN_HS</network>
			<fitment>mandatory</fitment>
		</module>
		<module>
			<module_code_name acronym="FIXEDMOD" ISOName="FIXEDMOD">FIXEDMOD_SYSTEM_A</module_code_name>
			<address type="phys" session="diag">0x60</address>
			<address type="phys" session="prog">0x60</address>
			<network>CAN_FIXED</network>
			<fitment>mandatory</fitment>
		</module>
		<module>
			<module_code_name acronym="PROGONLY" ISOName="PROGONLY">PROGONLY_SYSTEM_A</module_code_name>
			<address type="can_tx" session="prog">0x333</address>
			<address type="can_rx" session="prog">0x33B</address>
			<network>CAN_HS</network>
		</module>
		<!-- K-line modules (ADR-0029): a one-byte node address, no CAN identifier. -->
		<module>
			<module_code_name acronym="DS2MOD" ISOName="DS2MOD">DS2MOD_SYSTEM_A</module_code_name>
			<address type="phys" session="diag">0x72</address>
			<address type="phys" session="prog">0x72</address>
			<network>DS2_PIN7</network>
			<fitment>optional</fitment>
		</module>
		<module>
			<module_code_name acronym="STARMOD" ISOName="STARMOD">STARMOD_SYSTEM_A</module_code_name>
			<address type="phys" session="diag">0x12</address>
			<network>KW2000STAR</network>
			<fitment>mandatory</fitment>
		</module>
	</module_fitment>
	<!--
	  Named data-identifier sets (ADR-0027). The NET set mixes identification
	  with data that is not (a distance, a legislated mirror) and one member
	  read with a service this product does not use; only its 0xF1xx members
	  read with 0x22 are identification. The SWDL and PDI sets are wholly
	  identification. synth_undefined is referenced above and never defined.
	-->
	<data_identifier_set id="synth_net">
		<did id="0xF111" name="ecu_core_assembly_pn" service_id="0x22">
			<tm>ECU Core Assembly Number</tm>
		</did>
		<did id="0xF188" name="vm_ecu_sw_pn" service_id="0x22">
			<tm>ECU Software Number</tm>
		</did>
		<did id="0xF190" name="ecu_vin" service_id="0x22">
			<tm>Vehicle Identification Number</tm>
		</did>
		<did id="0xF1A0" name="synth_no_text" service_id="0x22"/>
		<did id="0xDD01" name="generic_pid_dd01" service_id="0x22">
			<tm>Total Distance</tm>
		</did>
		<did id="0xF802" name="vehicle_id_number" service_id="0x09">
			<tm>Vehicle Identification Number</tm>
		</did>
	</data_identifier_set>
	<data_identifier_set id="synth_swdl_std">
		<did id="0xF188" name="vm_ecu_sw_pn" service_id="0x22">
			<tm>ECU Software Number</tm>
		</did>
		<did id="0xF124" name="ecu_cal_01_pn" service_id="0x22">
			<tm>ECU Calibration Data 1 Number</tm>
		</did>
	</data_identifier_set>
	<data_identifier_set id="synth_swdl_plus">
		<did id="0xF188" name="vm_ecu_sw_pn" service_id="0x22">
			<tm>ECU Software Number</tm>
		</did>
		<did id="0xF125" name="ecu_cal_02_pn" service_id="0x22">
			<tm>ECU Calibration Data 2 Number</tm>
		</did>
	</data_identifier_set>
	<data_identifier_set id="synth_pdi">
		<did id="0xF111" name="ecu_core_assembly_pn" service_id="0x22">
			<tm>ECU Core Assembly Number</tm>
		</did>
		<did id="0xF18C" name="ecu_sn" service_id="0x22">
			<tm>ECU Serial Number</tm>
		</did>
	</data_identifier_set>
</platform>
