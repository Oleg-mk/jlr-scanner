<dtcCode>0x0000</dtcCode>
<language isoCode="ru">Russian</language>
<dtcDescriptionQualification>
<dtcDescriptionSelection dtcDescriptionId="1001" helpScreenDataNameId="9001" faultType="17" faultTypeHelpScreenDataNameId="9002">
