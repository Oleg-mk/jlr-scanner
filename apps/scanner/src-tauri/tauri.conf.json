{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProwlOne",
  "version": "0.9.10",
  "identifier": "com.prowlone.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir apps/scanner/frontend dev",
    "beforeBuildCommand": "pnpm --dir apps/scanner/frontend build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProwlOne",
        "width": 1280,
        "height": 860,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
